CREATE TABLE characterEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    species TEXT NOT NULL,
    status TEXT NOT NULL,
    imageUrl TEXT NOT NULL,
    originName TEXT NOT NULL,
    locationName TEXT NOT NULL,
    originUrl TEXT NOT NULL,
    locationUrl TEXT NOT NULL,
    episodeUrls TEXT NOT NULL
);

selectAll:
SELECT * FROM characterEntity;

selectById:
SELECT * FROM characterEntity WHERE id = ?;

insertOrReplace:
INSERT OR REPLACE INTO characterEntity (
    id, name, species, status, imageUrl, originName, locationName, originUrl, locationUrl, episodeUrls
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAll:
DELETE FROM characterEntity;